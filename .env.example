# =============================================================================
# FastAPI 多模态 RAG 服务配置示例
# =============================================================================
#
# 使用方法：
#   1. 复制本文件并命名为 .env。
#   2. 根据下面的标记修改配置。
#   3. 不要把包含真实密码或 API Key 的 .env 提交到 Git。
#
# 标记说明：
#   [标准默认]   面向已准备好基础设施和云端凭证的全功能部署默认值。
#   [必须修改]   启用对应功能前必须填写或修改，否则服务会拒绝启动或调用失败。
#   [生产必改]   本地开发可原样使用，生产环境必须修改。
#   [按需修改]   只有切换部署方式或调整功能时才需要修改。
#
# 什么是 mock：
#   mock 是“模拟实现”，不加载真实 Qwen 模型，也不需要 NVIDIA GPU。
#   Mock Embedding 使用确定性的哈希算法生成固定维度向量；
#   Mock Reranker 使用简单的文本词项重合度计算排序分数。
#   它适合验证上传、解析、索引、搜索、权限和 API 流程是否正确，但检索质量
#   不代表真实 Qwen3-VL-Embedding/Reranker 的效果，不能用于生产效果评测。
#
# 注意：
#   本文件默认是“全功能云端增强模式”，假定使用者已经准备好：
#     - PostgreSQL；
#     - Redis 和 Celery Worker；
#     - Qdrant；
#     - MinIO；
#     - DashScope API Key；
#     - PaddleOCR Access Token。
#   首次使用时必须填写 MinIO 凭证、DASHSCOPE_API_KEY 和
#   PADDLEOCR_ACCESS_TOKEN。本地 Qwen、vLLM、SQLite、进程内向量库、
#   本地文件存储和 Mock 模型均为可选替代方案，不是本文件默认值。


# =============================================================================
# 1. 应用基础配置
# =============================================================================

# [标准默认] 运行环境名称，可用于区分 development、test、production。
APP_ENV=development

# [按需修改] FastAPI 服务名称，主要用于日志和服务标识。
APP_NAME=multimodal-rag

# [按需修改] 日志级别：DEBUG、INFO、WARNING、ERROR。
# 本地排错可以改为 DEBUG；生产通常使用 INFO。
LOG_LEVEL=INFO

# [按需修改] 所有业务 API 的统一路径前缀。
# 保持默认时，搜索接口地址为 /v1/search。
API_PREFIX=/v1


# =============================================================================
# 2. 数据库：SQLite / PostgreSQL
# =============================================================================

# [标准默认，生产必改密码/主机]
# DATABASE_URL 是应用实际读取的数据库地址。本示例默认连接 PostgreSQL。
# 请确认数据库 rag 和用户 rag 已创建，并根据实际部署修改主机、端口、
# 用户名、密码和数据库名。
DATABASE_URL=postgresql+asyncpg://rag:123456@localhost:5432/rag

# [参考配置] 与当前 DATABASE_URL 相同，便于外部部署脚本单独读取。
# 应用自身只读取 DATABASE_URL；修改连接信息时应同步修改这两个值。
POSTGRES_DATABASE_URL=postgresql+asyncpg://rag:123456@localhost:5432/rag

# [测试时按需替换] 若只运行自动化测试或轻量调试，可将 DATABASE_URL 改为：
# DATABASE_URL=sqlite+aiosqlite:///./data/rag.db

# [生产必改] PostgreSQL 密码。当前 123456 仅是约定的本地开发密码。
# 如果修改此值，也要同步修改 DATABASE_URL 中的密码。
POSTGRES_PASSWORD=123456

# [按需修改]
# true：服务启动时自动创建缺失的数据表，仅适合临时开发环境。
# false：不自动建表；标准部署应先执行 `alembic upgrade head`。
AUTO_CREATE_SCHEMA=false


# =============================================================================
# 3. Redis 与 Celery 异步任务
# =============================================================================

# [生产必改] Redis 密码。当前 123456 仅用于本地开发。
REDIS_PASSWORD=123456

# [启用 Celery 前必须检查] Redis Broker 和结果后端地址。
# 格式：redis://:密码@主机:端口/数据库编号
REDIS_URL=redis://:123456@localhost:6379/0

# [标准默认]
# false：使用真正的 Celery 异步任务；必须启动 Redis 和 Celery Worker。
# true：不向 Redis/Celery 投递任务，由 FastAPI BackgroundTasks 在当前进程
#       执行导入流程，只适合自动化测试或轻量调试。
#
# 重要：设为 false 时，VECTOR_PROVIDER 不能使用 memory，因为 API 和
# Worker 是不同进程，进程内向量数据无法共享；此时必须使用 qdrant。
CELERY_TASK_ALWAYS_EAGER=false


# =============================================================================
# 4. 向量存储：进程内存 / Qdrant
# =============================================================================

# [标准默认] 可选值：qdrant、memory。
#
# memory：
#   使用当前 Python 进程内的临时向量库，不需要启动 Qdrant。
#   服务重启后向量会丢失，只适合本地流程验证和测试。
#
# qdrant：
#   使用真实 Qdrant 服务，数据可持久化，并支持 API/Worker 多进程共享。
#   启用时必须保证 QDRANT_URL 可访问。
VECTOR_PROVIDER=qdrant

# [启用 qdrant 时必须检查] Qdrant HTTP 地址。
QDRANT_URL=http://localhost:6333

# [按需修改] Qdrant Collection 名称。
# 所有文本与图片节点写入同一个 Collection。
QDRANT_COLLECTION=knowledge_nodes_dashscope_2048


# =============================================================================
# 5. 对象存储：本地文件系统 / MinIO
# =============================================================================

# [标准默认] 可选值：minio、filesystem。
#
# filesystem：
#   将原始文档、图片和解析产物保存到本机目录，不需要启动 MinIO。
#   只适合本地开发；多实例部署时无法保证文件共享。
#
# minio：
#   使用真实 MinIO 私有 Bucket，适合联调和生产部署。
#   启用后必须填写 MinIO 地址、Access Key 和 Secret Key。
STORAGE_PROVIDER=minio

# [使用 filesystem 时按需修改] 本地对象文件保存目录。
LOCAL_STORAGE_ROOT=./data/objects

# [启用 minio 时必须修改或确认] MinIO API 地址，不要填写控制台端口 9001。
MINIO_ENDPOINT=localhost:9000

# [启用 minio 时必须填写] MinIO 访问凭证。
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# [启用 minio 时必须确认]
# false 表示使用 HTTP；生产环境启用 TLS 后应改为 true。
MINIO_SECURE=false

# [按需修改] 三类私有 Bucket 的名称。
# originals：原始 PDF/DOCX/PPTX。
# assets：抽取图片和整页渲染图。
# derived：Docling JSON、OCR/VLM 原始结果等派生数据。
MINIO_BUCKET_ORIGINALS=rag-originals
MINIO_BUCKET_ASSETS=rag-assets
MINIO_BUCKET_DERIVED=rag-derived


# =============================================================================
# 6. 文档解析器：Docling / MinerU 预留
# =============================================================================

# [标准默认] 当前业务文档使用 docling。
# 使用前需要安装可选依赖：
#   python -m pip install -e ".[docling]"
#
# plain_text 仅用于开发测试 TXT/Markdown 流程，不支持方案要求的
# PDF、DOCX、PPTX，不应作为正式配置。
PARSER_PROVIDER=docling

# [使用 docling 解析 PDF 时必须修改或确认]
# Docling 的本地模型根目录。该目录应是 `docling-tools models download`
# 的 --output-dir，而不是其中某一个具体模型的子目录。
#
# 当前 PDF 管线至少需要以下子目录：
#   docling-project--docling-layout-heron  页面布局识别
#   docling-project--TableFormerV2         TableFormer V2 表格结构识别
#   RapidOcr                               RapidOCR 扫描件 OCR
#
# Windows 示例：C:/Models/Docling。推荐使用正斜杠，避免反斜杠转义问题。
# 如果只处理 DOCX/PPTX，部分 Docling 模型可能不会被加载；但正式环境仍
# 建议预下载并配置，避免第一次处理 PDF 时临时联网下载。
DOCLING_ARTIFACTS_PATH=C:/Models/Docling

# [标准默认] 显式使用 RapidOCR，避免 Docling 的 auto 模式因环境差异改用
# EasyOCR。仅在排查第三方兼容问题时才临时改为 auto。
DOCLING_OCR_ENGINE=rapidocr

# [标准默认] RapidOCR 推理后端。项目的 docling 可选依赖会同时安装
# RapidOCR 和 PyTorch；高性能服务器安装 CUDA 版 PyTorch 后可使用 GPU。
# 只需要 CPU 通用部署时可改为 onnxruntime。
# 可选值：onnxruntime、openvino、paddle、torch。
DOCLING_RAPIDOCR_BACKEND=torch

# [通常无需修改] RapidOCR 模型语言，多个值用英文逗号分隔。
# 当前中文业务材料使用 chinese；RapidOCR 一次会选择一套语言模型，混合
# 中英文材料也可保持 chinese。
DOCLING_OCR_LANGUAGES=chinese

# [保持 false]
# MinerU 因许可证审核要求默认禁用。目前代码只保留远程适配器骨架，
# 即使改为 true，也需要先完成许可证审核和远程服务契约实现。
MINERU_ENABLED=false

# [未来启用 MinerU 时必须填写] 已审核的 MinerU 远程服务地址。
MINERU_BASE_URL=


# =============================================================================
# 7. Embedding：Mock / 进程内 Qwen / vLLM 服务
# =============================================================================

# [标准默认] 可选值：qwen_local、vllm、dashscope、mock。
#
# qwen_local：
#   加载真实 Qwen3-VL-Embedding 模型。启用前必须准备官方代码仓库、
#   模型文件和模型运行依赖。无 GPU 也可以尝试 CPU，但速度会很慢，
#   并需要较大的内存。
#
# vllm：
#   不在 FastAPI/Celery 进程中加载模型，而是调用独立部署的 vLLM
#   多模态 /v1/embeddings 服务。服务端必须使用 vLLM >= 0.14.0，
#   并以 --runner pooling 启动 Qwen3-VL-Embedding。
#
# dashscope：
#   调用阿里云百炼 qwen3-vl-embedding 原生多模态接口。图片节点会把图片、
#   OCR 和描述融合为一个向量，并显式请求 EMBEDDING_DIMENSION 维。
#   启用时还必须在第 10 节填写共享的 DASHSCOPE_API_KEY。
#
# mock：
#   不加载模型、不需要 GPU，使用哈希向量验证检索代码链路。
#   不能用于判断真实语义召回质量，仅供测试时手动切换。
EMBEDDING_PROVIDER=dashscope

# [使用真实模型时必须确认] 应用写入文档版本和 Qdrant Payload 的模型标识。
# 使用 dashscope 时应与 DASHSCOPE_EMBEDDING_MODEL 一致；使用 qwen_local
# 或 vllm 时可填写 Hugging Face/ModelScope 模型标识。
EMBEDDING_MODEL=qwen3-vl-embedding

# [使用真实模型时必须确认] 模型版本标签。
# 云端托管模型无法锁定本地 commit 时使用 dashscope-managed；本地模型应
# 填写经过验证并锁定的 revision/commit。
EMBEDDING_REVISION=dashscope-managed

# [一般不要修改] Qwen3-VL-Embedding-2B 的目标向量维度。
# 已创建 Qdrant Collection 后不能直接修改维度；修改需要重建 Collection。
EMBEDDING_DIMENSION=2048

# [使用 vllm 时必须核对] vLLM OpenAI-compatible API 根地址。
# 必须包含 /v1，但不要包含 /embeddings。
EMBEDDING_VLLM_BASE_URL=http://127.0.0.1:8200/v1

# [按部署方式填写] 必须与 Embedding vLLM 的 --api-key 一致。
# 服务未启用认证时可以留空。
EMBEDDING_VLLM_API_KEY=

# [使用 vllm 时必须核对] 必须等于 vLLM 的 --served-model-name。
EMBEDDING_VLLM_MODEL=qwen3-vl-embedding-2b

# [按需修改] 单次 /embeddings 请求包含的输入数量。
# 图片会以 Base64 进入请求体；遇到请求体过大或显存峰值过高时应降低。
EMBEDDING_VLLM_BATCH_SIZE=8

# [按需修改] 单批 Embedding 请求超时，单位为秒。
EMBEDDING_VLLM_TIMEOUT_SECONDS=120

# [使用 dashscope 时一般无需修改] 百炼多模态 Embedding 完整请求地址。
DASHSCOPE_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding

# [使用 dashscope 时必须确认] 百炼云端模型 ID。
DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding

# [按需修改] 同时发往百炼的最大 Embedding 请求数。
# 每个业务节点单独请求，以确保图文融合后只返回一个向量。
DASHSCOPE_EMBEDDING_CONCURRENCY=4

# [按需修改] 单次百炼 Embedding 请求超时，单位为秒。
DASHSCOPE_EMBEDDING_TIMEOUT_SECONDS=120

# [高级配置] 模型目录附带的 Embedding Python 模块和类名。
# 官方模型快照包含 scripts/qwen3_vl_embedding.py，因此推荐以下值。
QWEN_EMBEDDING_MODULE=qwen3_vl_embedding
QWEN_EMBEDDING_CLASS=Qwen3VLEmbedder

# [使用 qwen_local 时必须修改] 已下载的 Embedding 模型本地目录。
QWEN_EMBEDDING_MODEL_PATH=./models/Qwen3-VL-Embedding-2B

# [使用 qwen_local 时必须修改] 包含上述 Python 模块的目录。
# 使用官方模型快照时，应填写 Embedding 模型目录下的 scripts 子目录。
QWEN_EMBEDDING_REPOSITORY_PATH=./models/Qwen3-VL-Embedding-2B/scripts

# =============================================================================
# 8. Reranker：Mock / 进程内 Qwen / vLLM 服务
# =============================================================================

# [标准默认] 可选值：qwen_local、vllm、dashscope、mock。
#
# qwen_local：
#   加载真实 Qwen3-VL-Reranker，对文本候选和图片候选统一重排。
#
# vllm：
#   调用独立部署的 vLLM /rerank 接口。服务端必须使用 vLLM >= 0.14.0、
#   --runner pooling、Qwen3VLForSequenceClassification 覆盖配置和官方
#   qwen3_vl_reranker.jinja 模板，否则分数可能不正确。
#
# dashscope：
#   调用阿里云百炼 qwen3-vl-rerank 原生接口，使用嵌套的 input 和
#   parameters 请求格式。启用时必须填写 DASHSCOPE_API_KEY。
#
# mock：
#   使用简单词项重合度排序，仅用于验证统一混排和 API 返回结构，
#   只供测试时手动切换。
RERANKER_PROVIDER=dashscope

# [使用真实模型时必须确认] Reranker 模型标识或云端模型 ID。
RERANKER_MODEL=qwen3-vl-rerank

# [使用真实模型时必须确认] 云端使用 dashscope-managed；本地模型填写
# 锁定的 revision/commit。
RERANKER_REVISION=dashscope-managed

# [使用 vllm 时必须核对] vLLM API 根地址。
# 可以包含 /v1；代码会调用该地址下的 /rerank。
RERANKER_VLLM_BASE_URL=http://127.0.0.1:8300/v1

# [按部署方式填写] 必须与 Reranker vLLM 的 --api-key 一致。
RERANKER_VLLM_API_KEY=

# [使用 vllm 时必须核对] 必须等于 vLLM 的 --served-model-name。
RERANKER_VLLM_MODEL=qwen3-vl-reranker-2b

# [按需修改] 单次 Reranker 请求超时，单位为秒。
RERANKER_VLLM_TIMEOUT_SECONDS=120

# [使用 dashscope 时必须核对]
# 下面是公共 DashScope 地址。若百炼控制台要求业务空间专属地址，应替换为：
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
DASHSCOPE_RERANKER_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# [使用 dashscope 时必须确认] 百炼云端模型 ID。
DASHSCOPE_RERANKER_MODEL=qwen3-vl-rerank

# [按需修改] 单次百炼 Reranker 请求超时，单位为秒。
DASHSCOPE_RERANKER_TIMEOUT_SECONDS=120

# [按需修改] 排序任务说明，建议使用英文。
DASHSCOPE_RERANKER_INSTRUCTION=Retrieve text passages or document images relevant to the user's query.

# [高级配置] 模型目录附带的 Reranker Python 模块和类名。
QWEN_RERANKER_MODULE=qwen3_vl_reranker
QWEN_RERANKER_CLASS=Qwen3VLReranker

# [使用 qwen_local 时必须修改] 已下载的 Reranker 模型本地目录。
QWEN_RERANKER_MODEL_PATH=./models/Qwen3-VL-Reranker-2B

# [使用 qwen_local 时必须修改] 包含上述 Python 模块的目录。
# 使用官方模型快照时，应填写 Reranker 模型目录下的 scripts 子目录。
QWEN_RERANKER_REPOSITORY_PATH=./models/Qwen3-VL-Reranker-2B/scripts

# =============================================================================
# 9. OCR：禁用 / PaddleOCR 官方异步 API
# =============================================================================

# [标准默认] 可选值：disabled、paddleocr。
#
# disabled：
#   不调用外部 OCR。Docling 自身提取到的文本仍可使用，但独立图片不会进行
#   PaddleOCR 增强。
#
# paddleocr：
#   将图片提交到 PaddleOCR 官方 Job API，轮询完成后下载 JSONL 结果。
#   启用前必须填写 PADDLEOCR_ACCESS_TOKEN。
OCR_PROVIDER=paddleocr

# [一般无需修改] PaddleOCR Job API 地址。
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs

# [启用 paddleocr 时必须填写] PaddleOCR Access Token。
# 不要在 .env.example 中填写真实 Token，只填写到被 Git 忽略的 .env。
PADDLEOCR_ACCESS_TOKEN=

# [按需修改] OCR/文档解析模型名称。
PADDLEOCR_MODEL=PaddleOCR-VL-1.6

# [按需修改] 任务状态轮询间隔，单位为秒。
# 过小会增加 API 请求频率；过大会增加导入等待时间。
PADDLEOCR_POLL_INTERVAL_SECONDS=5

# [按需修改] 单个 OCR Job 的总等待超时，单位为秒。
PADDLEOCR_TIMEOUT_SECONDS=600


# =============================================================================
# 10. 图片描述 VLM：禁用 / 本地 vLLM / OpenAI 兼容服务 / 阿里云百炼
# =============================================================================

# [标准默认] 可选值：disabled、vllm、openai_compatible、dashscope。
#
# disabled：
#   不调用外部 VLM，图片仍可依靠原图、标题、相关正文和已有 OCR 建立索引。
#
# vllm：
#   调用独立部署的 vLLM OpenAI-compatible Chat Completions 服务。
#   服务器使用本地 Qwen3-VL-8B-Instruct-FP8 时推荐选择此值。
#
# openai_compatible：
#   与 vllm 使用同一套调用协议和下方 VLM_* 参数，适用于其他兼容
#   POST /v1/chat/completions 且支持 image_url 的多模态服务。
#
# dashscope：
#   通过阿里云百炼 OpenAI 兼容接口调用 qwen3.7-flash，生成结构化图片描述。
#   启用前必须填写 DASHSCOPE_API_KEY。
VLM_PROVIDER=dashscope

# -----------------------------------------------------------------------------
# 本地 vLLM / 通用 OpenAI-compatible VLM 配置
# -----------------------------------------------------------------------------

# [启用 vllm/openai_compatible 时必须核对]
# OpenAI-compatible API 根地址，必须包含 /v1，但不要写 /chat/completions。
# FastAPI 和 vLLM 都直接运行在同一台服务器时可保持 127.0.0.1。
# 若 FastAPI 在容器内运行，127.0.0.1 指向该容器自身，需要改成 vLLM 容器名、
# host.docker.internal 或宿主机可达地址。
VLM_BASE_URL=http://127.0.0.1:8100/v1

# [按部署方式填写]
# 必须与启动 vLLM 时的 --api-key 完全相同。
# 若 vLLM 没有配置 --api-key，可以留空；生产环境不建议暴露无认证端口。
VLM_API_KEY=

# [启用 vllm/openai_compatible 时必须核对]
# 请求体中的 model 名，必须等于 vLLM 的 --served-model-name；它不是模型目录。
VLM_MODEL=qwen3-vl-8b-instruct-fp8

# [按需修改] 单张图片描述允许生成的最大 token 数。
# 结构化图片描述通常 512~800 足够；值越大，显存占用和延迟可能越高。
VLM_MAX_TOKENS=800

# -----------------------------------------------------------------------------
# 阿里云百炼 DashScope 配置
# -----------------------------------------------------------------------------

# [启用任一 dashscope Provider 时必须填写] 阿里云百炼 API Key。
# Embedding、Reranker 和 VLM 共用此 Key。
# 不要在 .env.example 中填写真实 Key，只填写到 .env。
DASHSCOPE_API_KEY=

# [一般无需修改] 阿里云百炼 OpenAI 兼容接口地址。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# [按需修改] 用于图片描述的多模态模型。
DASHSCOPE_VLM_MODEL=qwen3.7-flash

# [按需修改] 单次 VLM 请求超时，单位为秒。
VLM_TIMEOUT_SECONDS=120


# =============================================================================
# 11. 上传、检索和降级策略
# =============================================================================

# [按需修改] 单个上传文件的最大字节数。
# 104857600 字节 = 100 MiB。
MAX_UPLOAD_BYTES=104857600

# [按需修改] 最终结果中同一文档最多占用的结果数量，防止单文档垄断。
MAX_RESULTS_PER_DOCUMENT=5

# [高级配置] Reciprocal Rank Fusion 的常量 k。
# 文档方案初始值为 60；修改后应重新运行检索评测。
RRF_K=60

# [标准默认]
# true：Reranker 异常时降级为 RRF 排序，并在响应中标记 rrf_fallback。
# false：Reranker 异常时 /search 返回 503，不进行降级。
RERANK_FALLBACK=true


# =============================================================================
# 最常见的三种配置方式
# =============================================================================
#
# A. 全功能云端增强部署（本文件默认值）
#    DATABASE_URL=postgresql+asyncpg://...
#    AUTO_CREATE_SCHEMA=false
#    CELERY_TASK_ALWAYS_EAGER=false
#    VECTOR_PROVIDER=qdrant
#    STORAGE_PROVIDER=minio
#    EMBEDDING_PROVIDER=dashscope
#    RERANKER_PROVIDER=dashscope
#    OCR_PROVIDER=paddleocr
#    VLM_PROVIDER=dashscope
#    [必须填写] MINIO_ACCESS_KEY、MINIO_SECRET_KEY
#    [必须填写] DASHSCOPE_API_KEY、PADDLEOCR_ACCESS_TOKEN
#
# B. 本地 GPU / vLLM 替代方案
#    EMBEDDING_PROVIDER=qwen_local 或 vllm
#    RERANKER_PROVIDER=qwen_local 或 vllm
#    VLM_PROVIDER=vllm
#    [必须核对] 对应模型路径、服务地址、模型名和 API Key
#
# C. 自动化测试或轻量调试（非默认）
#    DATABASE_URL=sqlite+aiosqlite:///./data/rag.db
#    AUTO_CREATE_SCHEMA=true
#    CELERY_TASK_ALWAYS_EAGER=true
#    VECTOR_PROVIDER=memory
#    STORAGE_PROVIDER=filesystem
#    EMBEDDING_PROVIDER=mock
#    RERANKER_PROVIDER=mock
#    OCR_PROVIDER=disabled
#    VLM_PROVIDER=disabled
